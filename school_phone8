        .person-info { font-size: 24px; color: #333; }
        .dept-tag { font-size: 16px; color: #666; margin-bottom: 5px; }
        .ext-number { font-size: 50px; font-weight: bold; color: #28a745; margin: 0; line-height: 1; }
        .single-result .result-item { flex-direction: column; text-align: center; padding: 40px 20px; border-left: none; border-top: 6px solid #28a745; }
        .single-result .person-info { font-size: 32px; margin-bottom: 20px; }
        .single-result .ext-number { font-size: 100px; }
        .error-msg { color: #dc3545; font-size: 20px; text-align: center; padding: 10px; }
        .suggestion-box { text-align: center; margin-top: 15px; padding: 15px; background: #fff3cd; border-radius: 10px; border: 1px solid #ffeeba;}
        .suggestion-btn {
            background-color: #ffc107; border: none; padding: 10px 20px; margin: 5px;
            border-radius: 8px; font-size: 16px; cursor: pointer; font-weight: bold; color: #333;
            transition: 0.2s;
        }
        .suggestion-btn:hover { background-color: #e0a800; }

        /* 分隔線與標題區 (下方) */
        h1 { 
            color: #333; font-size: 24px; margin-top: 40px; margin-bottom: 10px;
            padding-top: 30px; border-top: 1px dashed #ccc; 
