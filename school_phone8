            try {
                const data = new Uint8Array(event.target.result);
                const workbook = XLSX.read(data, {type: 'array'});
                
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                const rawJson = XLSX.utils.sheet_to_json(worksheet);
                
                let newDatabase = [];
                rawJson.forEach(row => {
                    const dName = row['姓名'] || row['Name'] || '';
                    const dExt = String(row['分機'] || row['Ext'] || '');
                    if (dName && dExt) {
                        newDatabase.push({
                            dept: row['處室'] || row['Dept'] || '',
                            title: row['職稱'] || row['Title'] || '',
                            name: dName,
                            ext: dExt
                        });
                    }
                });

                if (newDatabase.length > 0) {
                    database = newDatabase;
                    localStorage.setItem('ext_database', JSON.stringify(database));
                }

                if (workbook.SheetNames.includes("語音學習記憶")) {
                    const memSheet = workbook.Sheets["語音學習記憶"];
                    const memJson = XLSX.utils.sheet_to_json(memSheet);
                    memJson.forEach(row => {
                        const wrong = row['辨識錯誤語音'];
                        const correct = row['對應正確姓名'];
                        if (wrong && correct) { 
                            learnedMemory[wrong] = correct; 
                        }
                    });
                    localStorage.setItem('ext_voice_memory', JSON.stringify(learnedMemory));
                }

                updateDbStatus();
                statusDiv.textContent = `✅ 匯入成功！已更新 ${database.length} 筆分機與 ${Object.keys(learnedMemory).length} 筆學習記憶。`;
            } catch (error) {
                console.error(error);
                statusDiv.textContent = '❌ 匯入失敗，請確認檔案格式是否正確。';
            }
            fileInput.value = '';
        };
        reader.readAsArrayBuffer(file);
    });
    
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognition;

    if (SpeechRecognition) {
        recognition = new SpeechRecognition();
        recognition.lang = 'zh-TW';
        recognition.interimResults = false;
        recognition.maxAlternatives = 1;

        recognition.onstart = function() {
            micBtn.classList.add('listening');
            statusDiv.textContent = '聆聽中...請說話';
            resultContainer.style.display = 'none';
        };

        recognition.onresult = function(event) {
            const transcript = event.results[0][0].transcript.replace(/\s+/g, '');
            statusDiv.textContent = `您說了：「${transcript}」`;
            searchDatabase(transcript);
        };

        recognition.onerror = function(event) {
            statusDiv.textContent = '發生錯誤，請再試一次。';
            micBtn.classList.remove('listening');
        };

        recognition.onend = function() {
            micBtn.classList.remove('listening');
        };

        micBtn.addEventListener('click', () => { recognition.start(); });
    } else {
        statusDiv.textContent = '不支援語音辨識，請使用 Chrome 瀏覽器。';
        micBtn.disabled = true;
    }

    function levenshteinDistance(a, b) {
        if(a.length == 0) return b.length; 
        if(b.length == 0) return a.length; 
        var matrix = [];
        for(var i = 0; i <= b.length; i++){ matrix[i] = [i]; }
        for(var j = 0; j <= a.length; j++){ matrix[0][j] = j; }
        for(var i = 1; i <= b.length; i++){
            for(var j = 1; j <= a.length; j++){
                if(b.charAt(i-1) == a.charAt(j-1)){
                    matrix[i][j] = matrix[i-1][j-1];
                } else {
                    matrix[i][j] = Math.min(matrix[i-1][j-1] + 1, Math.min(matrix[i][j-1] + 1, matrix[i-1][j] + 1));
                }
            }
        }
        return matrix[b.length][a.length];
    }

    window.learnAndSearch = function(wrongQuery, correctName) {
        learnedMemory[wrongQuery] = correctName;
        localStorage.setItem('ext_voice_memory', JSON.stringify(learnedMemory));
        statusDiv.textContent = `已記住：「${wrongQuery}」對應為「${correctName}」`;
        searchDatabase(correctName, true); 
    };

    function searchDatabase(query, isExact = false) {
        query = query.trim();
        if (!query) return;

        if (!isExact && learnedMemory[query]) {
            query = learnedMemory[query];
        }

        let results = [];
        const depts = [...new Set(database.map(item => item.dept))];
        const targetDept = depts.find(d => query === d || (query.length >= 2 && d.startsWith(query) && query.length <= d.length));
        const queryPinyin = pinyin(query, { toneType: 'none', type: 'array' }).join('');

        if (targetDept) {
            results = database.filter(item => item.dept === targetDept);
        } else {
            results = database.filter(item => {
                if (item.name === query) return true; 
                
                const searchPool = item.dept + item.title + item.name;
                if (searchPool.includes(query)) return true;
                if (query.length === 2 && item.name.length === 3 && query[0] === item.name[0] && query[1] === item.name[2]) return true;
                
                let allCharsMatch = true;
                for (let char of query) { if (!searchPool.includes(char)) { allCharsMatch = false; break; } }
                if (allCharsMatch) return true;

                const namePinyin = pinyin(item.name, { toneType: 'none', type: 'array' }).join('');
                if (namePinyin.includes(queryPinyin)) return true;

                return false;
            });
        }

        displayResults(results, query, targetDept);
    }

    function displayResults(results, originalQuery, targetDept) {
        resultContainer.style.display = 'block';
        resultContainer.innerHTML = '';
        resultContainer.className = '';

        if (results.length === 0) {
            let suggestions = database.map(item => {
                const namePinyin = pinyin(item.name, { toneType: 'none', type: 'array' }).join('');
                const queryPinyin = pinyin(originalQuery, { toneType: 'none', type: 'array' }).join('');
                const charDist = levenshteinDistance(originalQuery, item.name);
                const pinyinDist = levenshteinDistance(queryPinyin, namePinyin);
                return { ...item, score: charDist * 2 + pinyinDist };
            });

            suggestions.sort((a, b) => a.score - b.score);
            let topSuggestions = suggestions.slice(0, 3);

            let errorHtml = `<div class="error-msg">找不到與「${originalQuery}」相符的分機</div>`;
            errorHtml += `<div class="suggestion-box"><p>您是不是要找：</p>`;
            topSuggestions.forEach(s => {
                errorHtml += `<button class="suggestion-btn" onclick="learnAndSearch('${originalQuery}', '${s.name}')">${s.dept} - ${s.name}</button>`;
            });
            errorHtml += `</div>`;
            
            resultContainer.innerHTML = errorHtml;
            speakOut(`找不到`);
            return;
        }

        if (results.length === 1) resultContainer.classList.add('single-result');

        results.forEach(person => {
            const itemDiv = document.createElement('div');
            itemDiv.className = 'result-item';
            itemDiv.innerHTML = `
                <div>
                    <div class="dept-tag">${person.dept}</div>
                    <div class="person-info">${person.title} <strong>${person.name}</strong></div>
                </div>
                <div class="ext-number">${person.ext}</div>
            `;
            resultContainer.appendChild(itemDiv);
        });

        // 語音播報邏輯調整
        if (targetDept) {
            speakOut(`已為您列出${targetDept}的所有分機。`);
        } else if (results.length === 1) {
            // 只有一位結果時，將數字拆開唸，並且去除「分機」兩個字
            const extSpoken = results[0].ext.split('').join(' ');
            speakOut(extSpoken);
        } else {
            // 列出多人時，不唸出分機號碼
            speakOut('已為您列出多筆相符資料。');
        }
    }

    function speakOut(text) {
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            const msg = new SpeechSynthesisUtterance(text);
            msg.lang = 'zh-TW';
            msg.rate = 0.95;
            window.speechSynthesis.speak(msg);
        }
    }
</script>
